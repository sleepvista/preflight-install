# Copy this file to .env (Windows PowerShell: Copy-Item .env.example .env)
# and fill in the values. INSTALL.md explains each one.

# Required. Encrypts the n8n API keys you register. Generate it once, keep it,
# and never change it casually: INSTALL.md says why.
PREFLIGHT_SECRET=

# Required. The password of Preflight's own database. Generate a second value
# the same way. Set it before the first start: the database keeps the password
# it was created with (INSTALL.md, "Changing the database password").
POSTGRES_PASSWORD=

# Required. Your n8n's exact version, e.g. 2.44.6 (n8n: Help > About).
PREFLIGHT_N8N_VERSION=

# Optional. Up to three more replay sandboxes: other n8n versions your clients
# run, or a version you want to test an upgrade to. Each needs its version
# here AND its profile in COMPOSE_PROFILES (sandbox-2, sandbox-3, sandbox-4),
# e.g. COMPOSE_PROFILES=sandbox-2,sandbox-3. install.cmd sets both for you.
# Before changing a version by hand, read INSTALL.md, "More than one n8n
# version": the sandbox's scratch database has to go first.
PREFLIGHT_N8N_VERSION_2=
PREFLIGHT_N8N_VERSION_3=
PREFLIGHT_N8N_VERSION_4=
COMPOSE_PROFILES=

# The timezone your n8n uses (its GENERIC_TIMEZONE), e.g. America/Edmonton.
PREFLIGHT_TIMEZONE=UTC

# Your beta key, from your invitation email. You can paste it into Preflight's
# page instead; if you set it here, change it here.
PREFLIGHT_BETA_KEY=
